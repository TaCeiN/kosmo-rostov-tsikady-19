# Шаблон. Скопируй в .env и подставь свои значения. Реальные ключи не коммить,
# .env уже в .gitignore.

# --- Google Earth Engine: нужен только для POST /analyze ---
# id Cloud-проекта, зарегистрированного в Earth Engine
# https://code.earthengine.google.com/register
GEE_PROJECT=

# Прод: путь к JSON-ключу сервисного аккаунта с ролью Earth Engine Resource Viewer.
# Держать ВНЕ репозитория. Для разработки не нужен — хватает `earthengine authenticate`.
# GEE_SERVICE_ACCOUNT_KEY=/secure/path/gee-key.json

# --- Gemini: ИИ-разбор полей (/ai/report, /ai/compare, /ai/ask) ---
# Ключ из Google AI Studio: https://aistudio.google.com/apikey
# Без него ИИ-панель в интерфейсе просто не показывается, остальное работает.
# Ключ читает ТОЛЬКО бэкенд и наружу не отдаёт: в браузер его класть нельзя.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- бэкенд ---
# путь к модели, если она лежит не в backend/artifacts/
# NDVI_MODEL=/abs/path/ndvi_model.pkl

# кому бэкенд разрешает CORS (через запятую), * = любой
NDVI_CORS=http://localhost:5173

# --- фронт ---
VITE_API_URL=http://localhost:8000

# --- карта ---
# Ключей не нужно: Leaflet + OpenStreetMap работают без них.
# Google Maps потребует свой ключ и не даст ничего, чего нет у OSM.
